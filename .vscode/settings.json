{
    // 核心配置：禁用微软 C/C++ 插件的 IntelliSense 引擎，交由 clangd 处理
    "C_Cpp.intelliSenseEngine": "disabled",
    
    // 禁用微软插件的自动补全和错误波浪线提示（避免与 clangd 重复）
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    
    "files.exclude": {
        "arch/[b-z]*": true,
        "arch/arm": false,
        "arch/arm64": false,
        "arch/alpha": true,
        "arch/arc": true,
        
        "**/*.cmd": true,
        "**/*.o": true,
    },
    "search.exclude": {
        ".git/**": true,
        ".cache/**": true,
        "**/*.cmd": true,
        "**/*.o": true,
        
        "arch/[b-z]*/**": true,
        "arch/arm/**": false,
        "arch/arm64/**": false,
        "arch/alpha/**": true,
        "arch/arc/**": true,
        
        
        "Documentation/**": true,
        "lib/**": true,
        "LICENSES/**": true,
        "rust/**": true,
        "samples/**": true,
        "scripts/**": true,
        "security/**": true,

    },

    "files.watcherExclude": {

        ".git/**": true,
        ".cache/**": true,
        "**/*.cmd": true,
        "**/*.o": true,

        "arch/[b-z]*/**": true,
        "arch/arm/**": false,
        "arch/arm64/**": false,
        "arch/alpha/**": true,
        "arch/arc/**": true,
        "Documentation/**": true,
        "lib/**": true,
        "LICENSES/**": true,
        "rust/**": true,
        "samples/**": true,
        "scripts/**": true,
        "security/**": true,
    },
}